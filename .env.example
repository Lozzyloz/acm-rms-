# Copy this file to .env and fill in real values. Never commit .env to source control.

# Port the server listens on
PORT=3000

# Node environment: "development" or "production"
NODE_ENV=development

# REQUIRED in production: a long, random, secret string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-secret

# Optional: override the SQLite database file location
# DB_PATH=./data/acm_rms.sqlite
